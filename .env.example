# Signs the identity cookies. Optional in development, required in production:
# openssl rand -base64 48
SESSION_SECRET=

# Vercel Blob. Empty means an in-memory store (local only).
BLOB_READ_WRITE_TOKEN=

# The only AI provider: Claude Haiku through the Anthropic API (src/features/ai). Required for any
# map, lesson, quiz or grade. Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional. Pins another model id. It must take adaptive thinking and output_config.effort the way
# claude-haiku-5-5 does (the default).
# ANTHROPIC_MODEL=claude-haiku-5-5

# Signs each published evidence page, so an edit to the store breaks its check.
# Any long random value, set once: openssl rand -hex 32
PROOF_SEAL_SECRET=
# Optional sign-in with Auth0 (src/features/auth). Without these, the app has no sign-in and everyone is a guest.
# AUTH0_SECRET: a new random value per host, 32+ characters: openssl rand -hex 32
# APP_BASE_URL: this host's URL, e.g. https://oryxlearn.vercel.app. Add <APP_BASE_URL>/api/auth/callback to Auth0's callback URLs.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=

# Resources tab (src/features/resources). Each is optional: a missing key drops only that source.
YOUTUBE_API_KEY=
GNEWS_API_KEY=
TADDY_API_KEY=
TADDY_USER_ID=
