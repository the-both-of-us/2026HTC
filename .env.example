# Signs the identity cookies. Optional in development, required in production:
# openssl rand -base64 48
SESSION_SECRET=

# Storage on AWS. With S3_BUCKET set, documents go to S3, and this wins over Blob.
# Leave it empty locally and on Vercel.
S3_BUCKET=
AWS_REGION=

# Pulled by `vercel env pull .env.local`. Vercel provides the OIDC token automatically when deployed.
VERCEL_OIDC_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Optional faster AI routes, tried before the Vercel AI Gateway when set.
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Later fallbacks, after the gateway. The models and region below are the defaults.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# A Bedrock API key, not AWS credentials. This model is not offered in ca-central-1.
BEDROCK_API_KEY=
# BEDROCK_REGION=us-west-2
# BEDROCK_MODEL=openai.gpt-oss-120b-1:0
