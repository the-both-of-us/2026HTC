# Signs the identity cookies. Optional in development, required in production:
# openssl rand -base64 48
SESSION_SECRET=

# Storage on AWS. With S3_BUCKET set, documents go to S3, and this wins over Blob.
# Leave it empty locally and on Vercel.
S3_BUCKET=
AWS_REGION=

# Pulled by `vercel env pull .env.local`. Vercel provides the OIDC token automatically when deployed.
VERCEL_OIDC_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Optional faster AI routes, tried before the Vercel AI Gateway when set.
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Later fallbacks, after the gateway. The models and region below are the defaults.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# A Bedrock API key, not AWS credentials. This model is not offered in ca-central-1.
BEDROCK_API_KEY=
# BEDROCK_REGION=us-west-2
# BEDROCK_MODEL=openai.gpt-oss-120b-1:0

# Voice mode. Without these, the voice routes answer 503 and the UI moves to typing.
# Ears: https://console.deepgram.com (the key needs Member role or higher)
# Use a dedicated project holding only the demo credit. Browser tokens can spend on its other speech APIs.
DEEPGRAM_API_KEY=
# Optional. The interviewer's voice, any flux-{voice}-en model. Defaults to flux-hannah-en.
# DEEPGRAM_VOICE=flux-hannah-en
# Voice: https://elevenlabs.io/app/developers/api-keys and any voice ID from your library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. Pins one model. Left empty, the best one your account allows is found automatically.
ELEVENLABS_MODEL_ID=
# Optional backups for the voice, tried after Deepgram: ElevenLabs above, then GEMINI_API_KEY.
# Signs each published evidence page, so an edit to the store breaks its check.
# Any long random value, set once: openssl rand -hex 32
PROOF_SEAL_SECRET=
# Optional sign-in with Auth0 (src/features/auth). Without these, the app has no sign-in and everyone is a guest.
# AUTH0_SECRET: a new random value per host, 32+ characters: openssl rand -hex 32
# APP_BASE_URL: this host's URL, e.g. https://oryxlearn.vercel.app. Add <APP_BASE_URL>/api/auth/callback to Auth0's callback URLs.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=
